# Databricks Lakebase (Postgres 17): every app table. Server-only; missing = DATABASE_NOT_CONFIGURED at first use.
LAKEBASE_URL=postgresql://<user>:<token>@<host>:5432/<database>?sslmode=require

# Supabase is AUTH ONLY (public project URL + anon key ship to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# Route-handler bearer secrets (32 hex chars each)
WATCHER_SECRET=REPLACE_ME_32_HEX_CHARS
MCP_SECRET=REPLACE_ME_32_HEX_CHARS

# MCP answers only as this user (D7)
OWNER_USER_ID=REPLACE_ME_UUID

# Feedback (D10). FEEDBACK_IP_SALT has no fallback default: unset = feedback refuses politely.
RESEND_API_KEY=REPLACE_ME
FEEDBACK_TO=REPLACE_ME
FEEDBACK_IP_SALT=REPLACE_ME_32_HEX_CHARS

# Fast-lane daily-drop notification (app/api/scan). Either one unset = notify skipped, scan still runs.
# Fine-grained GitHub PAT with issues:write on the repo below.
GITHUB_ISSUES_PAT=
# "owner/repo" for the daily issue; the @mention is derived from the owner.
SCOUT_ISSUE_REPO=
